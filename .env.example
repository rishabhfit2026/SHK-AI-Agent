# --- Groq (required for chat, drafting, AI brief). Key from https://console.groq.com/keys ---
GROQ_API_KEY=
# Must support tool calling. Alternatives: llama-3.3-70b-versatile, openai/gpt-oss-20b (faster, cheaper)
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss/qwen models: low | medium | high
GROQ_REASONING_EFFORT=medium

# --- Staff dashboard login (/staff) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# --- Customer portal login cookie: long random secret (keep private) ---
SECRET_KEY=

# --- Email (SMTP) for reminders, quotes, invites. Blank = messages only go to the portal inbox ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sales@shkraipur.com
# Directors who receive the 08:00 brief by email, comma-separated
MANAGEMENT_EMAILS=

# --- NVIDIA Nemotron OCR (reads payment proofs and invoices). Blank = OCR off, fields typed by hand ---
# Self-hosted NIM: http://<gpu-server>:8000/v1/infer (nemotron-ocr-v1) or .../v1/ocr (nemotron-ocr-v2)
NEMOTRON_OCR_URL=
# Only for NVIDIA-hosted endpoints (nvapi-...); leave blank for self-hosted
NEMOTRON_OCR_API_KEY=
NEMOTRON_OCR_MERGE_LEVEL=

# --- Website: public URL of this app, and sites allowed to embed the chat widget ---
ALLOWED_ORIGINS=https://shkraipur.com,https://www.shkraipur.com
PUBLIC_BASE_URL=http://localhost:8000

# --- Business rules ---
GST_RATE=0.18
QUOTE_AUTO_LIMIT_INR=5000000
REORDER_LAPSE_FACTOR=1.5
# DATABASE_URL=sqlite:///data/shk.db

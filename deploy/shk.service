# systemd service: keeps the app running and restarts it on crash/reboot.
# Install: sudo cp deploy/shk.service /etc/systemd/system/ && sudo systemctl enable --now shk
[Unit]
Description=SHK Sales Desk
After=network.target

[Service]
User=shk
WorkingDirectory=/opt/shk
# One worker only: the daily jobs (brief, reminders) run inside the app process.
ExecStart=/home/shk/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
